#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * qtphp — TypePHP\Qt 命令行工具。
 *
 * 用法：
 *   qtphp doctor            检查工具链（Qt/MSVC/tpc/PHP）
 *   qtphp new <name>        创建新项目
 *   qtphp build <path>      编译项目
 *   qtphp run <path>        运行项目
 *   qtphp package <path>    打包项目
 *   qtphp test              运行测试
 *   qtphp lint              校验桥接契约
 */

// 自动定位项目根目录
$rootDir = dirname(__DIR__);
$srcDir = $rootDir . '/src';
$binDir = $rootDir . '/bin';

// 加载核心类
require_once $srcDir . '/FakeBridge.php';
require_once $srcDir . '/WidgetTree.php';
require_once $srcDir . '/QtApp.php';

use TypePHP\Qt\FakeBridge;
use TypePHP\Qt\WidgetTree;
use TypePHP\Qt\QtApp;

// ── 颜色输出 ──

function color(string $text, string $color): string
{
    $codes = [
        'red' => "\033[31m",
        'green' => "\033[32m",
        'yellow' => "\033[33m",
        'blue' => "\033[34m",
        'cyan' => "\033[36m",
        'bold' => "\033[1m",
        'reset' => "\033[0m",
    ];
    return ($codes[$color] ?? '') . $text . $codes['reset'];
}

function info(string $msg): void
{
    echo color('[INFO] ', 'cyan') . $msg . PHP_EOL;
}

function success(string $msg): void
{
    echo color('[OK] ', 'green') . $msg . PHP_EOL;
}

function warning(string $msg): void
{
    echo color('[WARN] ', 'yellow') . $msg . PHP_EOL;
}

function error(string $msg): void
{
    echo color('[ERROR] ', 'red') . $msg . PHP_EOL;
}

// ── 命令实现 ──

function cmdDoctor(): int
{
    echo color('=== TypePHP\\Qt 工具链检查 ===', 'bold') . PHP_EOL . PHP_EOL;

    $allOk = true;

    // PHP
    $phpVersion = PHP_VERSION;
    if (version_compare($phpVersion, '8.1.0', '>=')) {
        success("PHP $phpVersion");
    } else {
        error("PHP $phpVersion (需要 >= 8.1)");
        $allOk = false;
    }

    // tpc
    $tpcPath = findTpc();
    if ($tpcPath) {
        success("tpc: $tpcPath");
    } else {
        error('tpc: 未找到（需要 swoole/typephp 或手动安装）');
        $allOk = false;
    }

    // AOT 链接用的 PHP 运行时库（tpc 原生发行包附带，或由 php-builder 自建）
    $runtimeDir = findRuntimeLibDir();
    if ($runtimeDir) {
        success("PHP 运行时库: $runtimeDir");
    } else {
        warning('PHP 运行时库: 未找到（首次 build 由 tpc 的 php-builder 自动编译，耗时较长）');
    }

    // Qt
    $qtDir = findQt();
    if ($qtDir) {
        success("Qt: $qtDir");
    } else {
        warning('Qt: 未找到（仅影响真实编译/运行，不影响测试）');
    }

    // C++ 工具链
    if (PHP_OS_FAMILY === 'Windows') {
        $vcvars = findVcvars();
        if ($vcvars) {
            success("MSVC: $vcvars");
        } else {
            warning('MSVC: 未找到（仅影响真实编译）');
        }
    } else {
        // macOS 上是 clang++，Debian/Ubuntu 的 Qt 包配套的是 g++，两个都认。
        $cxx = '';
        foreach (['clang++', 'g++'] as $probe) {
            $found = trim((string) shell_exec('command -v ' . $probe . ' 2>/dev/null'));
            if ($found !== '') {
                $cxx = $found;
                break;
            }
        }
        if ($cxx !== '') {
            success("C++: $cxx");
        } else {
            warning('C++: 未找到 clang++/g++（macOS 需先 xcode-select --install，Linux 需 apt install g++）');
        }
    }

    // Linux 的前置不止 Qt：tpc 的 php-builder 要现编 PHP 源码，缺一个包就是一次失败编译（F21/F22）。
    if (PHP_OS_FAMILY === 'Linux') {
        $missing = linuxMissingPackages();
        if (!$missing) {
            success('Linux 构建前置: 齐全');
        } else {
            warning('Linux 构建前置缺失: ' . implode('、', $missing));
            info('  apt install -y ' . implode(' ', $missing));
        }
    }

    // PHPUnit
    $phpunit = $GLOBALS['rootDir'] . '/vendor/bin/phpunit';
    if (file_exists($phpunit)) {
        success("PHPUnit: $phpunit");
    } else {
        warning('PHPUnit: 未找到（运行 composer install 安装）');
    }

    echo PHP_EOL;
    if ($allOk) {
        success('核心工具链就绪！');
    } else {
        error('部分工具链缺失，请安装后重试。');
    }

    return $allOk ? 0 : 1;
}

/**
 * 定位 tpc 编译器。
 *
 * 优先级沿用 composer 驱动优先（macOS/Linux 的完整链路都建立在 tpc 自建私有运行时之上，
 * 见 F11.3），但加两个 Windows 专属的逃生口 —— 那里 composer 驱动可能**装得出却跑不通**：
 *
 * composer 只发 `vendor/bin/tpc.php` 这个驱动，它依赖同仓库的 `vendor/swoole/phpx`
 * **源码树**，而该源码树不含编译产物（`build/phpx.dll`、`lib/phpx.lib` 要 phpx 工具链自建）。
 * 原生 tpc.exe 发行包则是自包含的，运行时就在它旁边。两路线混用会直接死在
 * `The PHPX runtime library was not found at: ...\phpx\build\phpx.dll`。
 *
 * 所以：选中的候选若**缺运行时**而候选表里另有**带运行时**的，就改用后者。
 * `TPC` / `TPC_DIR` 可显式指定，用于 CI 与多版本共存。
 */
function findTpc(): ?string
{
    // 显式指定的一律照用，不做运行时体检（用户知道自己在做什么）
    $envTpc = getenv('TPC');
    if ($envTpc && is_file($envTpc)) {
        return $envTpc;
    }

    // composer 装的包只带 bin/tpc.php（bin/tpc 是各平台的预编译二进制，不会随包发布）
    $candidates = [$GLOBALS['rootDir'] . '/vendor/bin/tpc'];

    $envDir = getenv('TPC_DIR');
    if ($envDir) {
        $candidates[] = rtrim($envDir, '/\\') . '/tpc' . (PHP_OS_FAMILY === 'Windows' ? '.exe' : '');
    }

    $candidates = array_merge($candidates, [
        $GLOBALS['rootDir'] . '/vendor/bin/tpc.php',
        $GLOBALS['rootDir'] . '/vendor/swoole/typephp/bin/tpc',
        $GLOBALS['rootDir'] . '/vendor/swoole/typephp/bin/tpc.php',
    ]);

    // PATH 与发行包惯例位置排在 composer 之后，仅在需要时兜底
    $exe = PHP_OS_FAMILY === 'Windows' ? 'tpc.exe' : 'tpc';
    foreach (array_merge(nativeTpcSearchDirs(), whichAll($exe)) as $path) {
        $candidates[] = $path;
    }

    $existing = array_values(array_filter($candidates, 'is_file'));
    if (!$existing) {
        return null;
    }

    // 优先选带运行时的；都没有则退回原来的「第一个存在的」
    foreach ($existing as $path) {
        if (tpcHasRuntime($path)) {
            return $path;
        }
    }
    return $existing[0];
}

/** 原生 tpc 发行包的候选安装目录（未设 TPC_DIR 时按惯例猜测）。 */
function nativeTpcSearchDirs(): array
{
    $dirs = [];
    $envDir = getenv('TPC_DIR');
    if ($envDir) {
        $dirs[] = $envDir;
    }
    $home = getenv('HOME') ?: getenv('USERPROFILE');
    if ($home) {
        foreach (glob(rtrim($home, '/\\') . '/tpc*', GLOB_ONLYDIR) ?: [] as $dir) {
            $dirs[] = $dir;
        }
        $dirs[] = rtrim($home, '/\\') . '/.typephp/tpc';
    }
    foreach (['/opt/tpc', '/usr/local/tpc', 'C:/tpc', 'D:/tpc'] as $dir) {
        $dirs[] = $dir;
    }
    $exe = PHP_OS_FAMILY === 'Windows' ? '/tpc.exe' : '/tpc';
    return array_map(fn(string $d): string => rtrim($d, '/\\') . $exe, $dirs);
}

/**
 * 这个 tpc 旁边有没有它需要的运行时？
 *
 * 判据与 `findRuntimeLibDir()` 的标记集保持一致：原生发行包的 SDK/phpx 目录、
 * 或 php 运行时 DLL/静态库。composer 驱动（`.php`）永远返回 false ——
 * 它的运行时在 `~/.typephp/php-builder`，可能**尚未构建**，正是本次故障的来源。
 */
function tpcHasRuntime(string $tpcPath): bool
{
    if (strtolower(pathinfo($tpcPath, PATHINFO_EXTENSION)) === 'php') {
        return false;
    }
    $dir = dirname($tpcPath);
    if (is_dir($dir . '/phpx') || is_dir($dir . '/SDK')) {
        return true;
    }
    foreach (['phpx.dll', 'php8ts.dll', 'libphp.a', 'libphp.dylib', 'libphp.so'] as $marker) {
        if (is_file($dir . '/' . $marker)) {
            return true;
        }
    }
    return false;
}

/** PATH 上所有同名可执行文件（Windows 的 `where` 可返回多个）。 */
function whichAll(string $name): array
{
    $probe = PHP_OS_FAMILY === 'Windows'
        ? 'where ' . escapeshellarg($name) . ' 2>nul'
        : 'command -v ' . escapeshellarg($name) . ' 2>/dev/null';
    $output = shell_exec($probe);
    if (!$output || !trim($output)) {
        return [];
    }
    $lines = preg_split('/\r?\n/', trim($output)) ?: [];
    return array_values(array_filter(array_map('trim', $lines), 'is_file'));
}

/** tpc 的 shell 命令词：PHP 脚本入口必须交给解释器，不能直接执行。 */
function tpcCommand(string $tpc): string
{
    if (strtolower(pathinfo($tpc, PATHINFO_EXTENSION)) === 'php') {
        return escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($tpc);
    }
    return escapeshellarg($tpc);
}

/**
 * Debian 系的多架构三元组（x86_64-linux-gnu / aarch64-linux-gnu），非这种布局返回 null。
 * 判定依据是 Qt6 的 CMake 配置目录存在，不是只猜 uname —— 发行版把 Qt 装在哪都能否决。
 */
function linuxMultiarchTriple(): ?string
{
    $triple = ['x86_64' => 'x86_64-linux-gnu', 'aarch64' => 'aarch64-linux-gnu',
               'arm64' => 'aarch64-linux-gnu'][php_uname('m')] ?? null;
    if ($triple === null || !is_dir('/usr/lib/' . $triple . '/cmake/Qt6')) {
        return null;
    }
    return $triple;
}

/**
 * Linux 编译/打包的硬前置缺了哪些 apt 包（返回值直接能拼成安装命令）。
 *
 * mac 上这些都是 brew 顺带装好的，Linux 得显式列：php-src 要 bison/re2c/autoconf 和
 * libxml2/sqlite3/onig/zlib 头，phpx 要 gmp/mpfr 头（F21），`package` 要 patchelf（F22）。
 * 头文件按 /usr/include 与 /usr/include/<三元组> 两处找 —— 实测 gmp.h 只在多架构目录下，
 * 而 onigmo.h 在 Debian 上根本不存在（libonig-dev 给的是 oniguruma.h）。
 */
function linuxMissingPackages(): array
{
    $incDirs = ['/usr/include'];
    $triple = linuxMultiarchTriple();
    if ($triple !== null) {
        $incDirs[] = '/usr/include/' . $triple;
    }

    $need = [
        'bison' => ['cmd' => 'bison'],
        're2c' => ['cmd' => 're2c'],
        'autoconf' => ['cmd' => 'autoconf'],
        'pkg-config' => ['cmd' => 'pkg-config'],
        'xz-utils' => ['cmd' => 'xz'],
        'patchelf' => ['cmd' => 'patchelf'],
        'libgmp-dev' => ['headers' => ['gmp.h', 'gmpxx.h']],
        'libmpfr-dev' => ['headers' => ['mpfr.h']],
        'libonig-dev' => ['headers' => ['oniguruma.h']],
        'libxml2-dev' => ['headers' => ['libxml2/libxml/parser.h']],
        'libsqlite3-dev' => ['headers' => ['sqlite3.h']],
        'zlib1g-dev' => ['headers' => ['zlib.h']],
    ];

    $missing = [];
    foreach ($need as $pkg => $probe) {
        if (isset($probe['cmd']) && trim((string) shell_exec('command -v ' . $probe['cmd'] . ' 2>/dev/null')) === '') {
            $missing[] = $pkg;
            continue;
        }
        foreach ($probe['headers'] ?? [] as $header) {
            $hit = false;
            foreach ($incDirs as $dir) {
                if (file_exists($dir . '/' . $header)) {
                    $hit = true;
                    break;
                }
            }
            if (!$hit) {
                $missing[] = $pkg;
                break;
            }
        }
    }
    return $missing;
}

function findQt(): ?string
{
    // Debian/Ubuntu 的 qt6-base-dev 是「前缀 /usr + 多架构子目录」布局，
    // 与 brew/官方安装器的 include+lib+bin 同构，所以这里返回前缀 /usr。
    if (PHP_OS_FAMILY === 'Linux') {
        $triple = linuxMultiarchTriple();
        if ($triple !== null && is_dir('/usr/include/' . $triple . '/qt6/QtCore')) {
            return '/usr';
        }
    }
    $candidates = [
        'D:/tools/Qt/6.9.3/msvc2022_64',
        'C:/Qt/6.9.3/msvc2022_64',
        'D:/Qt/6.9.3/msvc2022_64',
        // Homebrew keg-only 前缀（qtbase 提供 QtCore/QtGui/QtWidgets）
        '/opt/homebrew/opt/qtbase',
        '/usr/local/opt/qtbase',
        '/opt/homebrew/opt/qt',
        '/usr/local/opt/qt',
    ];
    foreach ($candidates as $path) {
        if (is_dir($path)) return $path;
    }
    $env = getenv('QT_DIR');
    if ($env && is_dir($env)) return $env;
    return null;
}

/**
 * 选择编译入口：平台文件 `project.macos.yml` / `project.windows.yml` / `project.linux.yml` 优先，
 * 它 `include` 公共的 project.yml 再覆盖平台段（Qt 位置、链接法、编译开关）。
 * 后缀用上游 typephp-compiler 示例的约定，不是 PHP_OS_FAMILY 的原值（Darwin ≠ macos）。
 * 没有平台文件时回落到 project.yml —— Windows 的行为与 build.bat 都不变。
 */
function resolveProjectYaml(string $path): string
{
    $suffix = ['Darwin' => 'macos', 'Windows' => 'windows', 'Linux' => 'linux'][PHP_OS_FAMILY] ?? 'linux';
    $platform = rtrim($path, '/\\') . '/project.' . $suffix . '.yml';
    return is_file($platform) ? $platform : rtrim($path, '/\\') . '/project.yml';
}

function findVcvars(): ?string
{
    $candidates = [
        'D:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvars64.bat',
        'C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvars64.bat',
        'C:/Program Files/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvars64.bat',
    ];
    foreach ($candidates as $path) {
        if (file_exists($path)) return $path;
    }
    return null;
}

function cmdNew(string $name): int
{
    $targetDir = getcwd() . DIRECTORY_SEPARATOR . $name;
    if (is_dir($targetDir)) {
        error("目录已存在: $targetDir");
        return 1;
    }

    info("创建项目: $name");

    // 创建目录结构
    mkdir($targetDir, 0755, true);
    mkdir($targetDir . '/src', 0755, true);
    mkdir($targetDir . '/assets', 0755, true);

    $qtDir = findQt() ?? 'D:/tools/Qt/6.9.3/msvc2022_64';
    // 框架根目录（composer 包位置）：由 CLI 自身位置推导
    $pkgDir = $GLOBALS['rootDir'];

    // project.yml —— 桥接 C++ 源码直接参与本应用编译（源码内联方案）
    $projectYml = <<<YML
name: {$name}
mode: bin
output: build/{$name}

sources:
  - src/main.php
  - {$pkgDir}/src/QtApp.php
  - {$pkgDir}/src/WidgetTree.php
  - {$pkgDir}/php-src/qt.stub.php
  - {$pkgDir}/cpp-src/qt_bridge.cc
  - {$pkgDir}/cpp-src/qt_widgets.cc

build-dir: build

cxx-std: c++20

include-paths:
  - {$pkgDir}/cpp-src
  - {$pkgDir}/php-src
  - {$qtDir}/include
  - {$qtDir}/include/QtCore
  - {$qtDir}/include/QtGui
  - {$qtDir}/include/QtWidgets

link-paths:
  - {$qtDir}/lib

link-libs:
  - Qt6Core.lib
  - Qt6Gui.lib
  - Qt6Widgets.lib

cxx-flags:
  - /Zc:__cplusplus
  - /permissive-
  - /EHsc
YML;
    file_put_contents($targetDir . '/project.yml', $projectYml);

    // project.macos.yml —— macOS 入口。brew 前缀按生成机实测推导：
    // Apple Silicon 是 /opt/homebrew/opt，Intel 是 /usr/local/opt，Windows 上生成时取默认值。
    $brewOpt = '/opt/homebrew/opt';
    if (preg_match('#^(.*)/opt/(?:qtbase|qt)$#', str_replace('\\', '/', $qtDir), $m)) {
        $brewOpt = $m[1] . '/opt';
    }
    $macQt = $brewOpt . '/qtbase';

    $macYml = <<<YML
# macOS 编译入口：`qtphp build` 在 Darwin 上用它（Windows 仍用 project.yml）。
# 组织方式对齐 typephp-compiler 的 examples/qt-taskboard/project.macos.yml。
#
# Homebrew 的 qtbase 是 framework 布局：include/ 下没有 QtCore/QtGui/QtWidgets 目录，
# 模块头在 lib/Qt<Module>.framework/Headers/。桥接源码写裸 include，而 QtWidgets 的转发头
# 内部又是限定 include，所以 -I（解裸名）与 -F（解限定名）必须同时给，缺一必失败。
#
# include 合并时列表是**整体替换、不是追加**，故框架内两条 include 路径要在下面重写一遍。
include:
  - project.yml

include-paths:
  - {$pkgDir}/cpp-src
  - {$pkgDir}/php-src
  - {$macQt}/lib/QtCore.framework/Headers
  - {$macQt}/lib/QtGui.framework/Headers
  - {$macQt}/lib/QtWidgets.framework/Headers

# 清掉 MSVC 的 .lib 名词法与链接目录：mac 走 framework，链接开关全在 ld-flags 里。
link-libs: []
link-paths: []

cxx-flags:
  - -F{$macQt}/lib
  - -DQT_CORE_LIB
  - -DQT_GUI_LIB
  - -DQT_WIDGETS_LIB

ld-flags:
  - -F{$macQt}/lib
  - -Wl,-framework,QtWidgets
  - -Wl,-framework,QtGui
  - -Wl,-framework,QtCore
  # brew 的 libiconv 是 keg-only，不会软链进 brew 的 lib，搜索路径与 rpath 都得显式给。
  - -L{$brewOpt}/libiconv/lib
  - -liconv
  - -Wl,-rpath,{$brewOpt}/libiconv/lib
  - -Wl,-rpath,{$macQt}/lib

# 宿主 PHP 通常只有 cli SAPI（无 libphp），让 tpc 从 php-src 现编私有 embed 运行时。
# 缓存在 ~/.typephp/php-builder 下，之后所有构建复用；首次构建会慢（要编译整个 php-src）。
php-builder:
  extensions: []
  zts: false
YML;
    file_put_contents($targetDir . '/project.macos.yml', $macYml);

    // project.linux.yml —— Linux 入口。Debian/Ubuntu 是「多架构三元组」布局：
    // 头在 /usr/include/<三元组>/qt6，库在 /usr/lib/<三元组>，mkspec 在 /usr/lib/<三元组>/qt6/mkspecs/linux-g++。
    // 三元组按当前机器推导（dpkg-architecture 的约定），不一致时改这三处路径即可。
    $triple = linuxMultiarchTriple() ?? (php_uname('m') . '-linux-gnu');
    $linInc = '/usr/include/' . $triple . '/qt6';
    $linLib = '/usr/lib/' . $triple;

    $linYml = <<<YML
# Linux 编译入口：`qtphp build` 在 Linux 上用它（Windows 用 project.yml，macOS 用 project.macos.yml）。
#
# Debian 系的 qt6-base-dev 是多架构布局，三元组 = `dpkg-architecture -qDEB_HOST_MULTIARCH`
# （x86_64-linux-gnu / aarch64-linux-gnu）。非 Debian 布局（Arch、openSUSE 的 /usr/include/qt6）
# 直接把下面的路径换成 `/usr/include/qt6` 与 `/usr/lib`。
#
# include 合并时列表是整体替换、不是追加，故框架内两条 include 路径要在下面重写一遍。
include:
  - project.yml

include-paths:
  - {$pkgDir}/cpp-src
  - {$pkgDir}/php-src
  - {$linInc}
  - {$linInc}/QtCore
  - {$linInc}/QtGui
  - {$linInc}/QtWidgets
  # Qt 头会引用 mkspec 里的 qplatformdefs.h
  - {$linLib}/qt6/mkspecs/linux-g++

# 清掉 MSVC 的 .lib 名词法；库搜索路径与链接开关全在 ld-flags 里。
link-libs: []
link-paths: []

cxx-flags:
  - -fPIC
  - -DQT_CORE_LIB
  - -DQT_GUI_LIB
  - -DQT_WIDGETS_LIB

ld-flags:
  - -L{$linLib}
  - -lQt6Widgets
  - -lQt6Gui
  - -lQt6Core

# 宿主 PHP 通常只有 cli SAPI（无 libphp），让 tpc 从 php-src 现编私有 embed 运行时。
# 缓存在 ~/.typephp/php-builder 下，之后所有构建复用；首次构建会慢（要编译整个 php-src）。
php-builder:
  extensions: []
  zts: false
YML;
    file_put_contents($targetDir . '/project.linux.yml', $linYml);

    // Info.macos.plist —— `qtphp package` 在 mac 上要往 dist/<Name>.app/Contents/Info.plist
    // 放一份；CFBundleExecutable 必须等于产物文件名（= 项目名）。
    $display = ucfirst($name);
    $plist = <<<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleExecutable</key>
    <string>{$name}</string>
    <key>CFBundleIdentifier</key>
    <string>org.typephp.qt.{$name}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>{$display}</string>
    <key>CFBundleDisplayName</key>
    <string>TypePHP Qt {$display}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
PLIST;
    file_put_contents($targetDir . '/Info.macos.plist', $plist);

    // main.php —— 状态驱动的声明式示例
    $mainPhp = <<<'PHP'
<?php

declare(strict_types=1);

use TypePHP\Qt\QtApp;
use TypePHP\Qt\WidgetTree;

// 注意：AOT 要求全局作用域只有声明，所以 $state 定义在 main() 里，
// 闭包用 use (&$state) 按引用捕获。命令行参数从 main() 的参数拿。
function main(int $argc, array $argv): void
{
    /** @var array<string, mixed> $state 应用状态：事件改它，视图读它。 */
    $state = ['name' => 'World', 'greeting' => 'Hello, World!', 'clicks' => 0, 'tray' => 0];

    $app = new QtApp();
    $app->create(['name' => 'MyApp', 'version' => '1.0']);
    $app->createWindow('My App', ['width' => 720, 'height' => 480, 'centered' => true]);
    $app->setStatus(['就绪']);

    // 系统托盘：图标路径相对**可执行文件目录**解析（build/ 与 dist/ 都成立）。
    // 不传 icon 时桥接会兜底用窗口图标/标准图标 —— 无图标的托盘项在
    // macOS/Linux 上根本不显示，所以 assets/ 里放了一个默认图标。
    $app->setTray([
        'icon' => 'assets/icon.png',
        'tooltip' => 'My App · 左键点一下，右键出菜单',
        'visible' => true,
        // 右键菜单（可省略）。绑了之后右击由 Qt 弹菜单，不再发 right 事件。
        'menu' => [
            ['type' => 'item', 'id' => 'tray.hello', 'text' => '打个招呼'],
            ['type' => 'separator'],
            ['type' => 'item', 'id' => 'tray.quit', 'text' => '退出'],
        ],
    ]);

    // 托盘激活不带 id（点的是托盘项本身），只能用 onAny 接。
    // $event['value'] 是手势：left / right / double / middle。
    $app->onAny('tray', function (array $event) use ($app, &$state) {
        $state['tray'] = (int) $state['tray'] + 1;
        $kind = (string) ($event['value'] ?? '');
        $app->setStatus(['托盘 ' . $kind . ' × ' . $state['tray']]);
    });

    // 托盘菜单项和菜单栏一样走 menu 事件，按惯例用 'tray.' 前缀区分。
    $app->on('tray.hello', 'menu', function () use ($app, &$state) {
        $state['greeting'] = 'Hello, World!';
        $app->setStatus(['托盘菜单：已重置问候语']);
    });

    $app->on('tray.quit', 'menu', function () use ($app) {
        $app->close();
    });

    // 视图函数每帧按 $state 重新描述界面，控件状态（光标/选中）由 diff 保留
    $app->view(function () use (&$state): array {
        return WidgetTree::vbox([
            WidgetTree::label((string) $state['greeting'], [
                'id' => 'greeting',
                'style' => 'font-size:20px;font-weight:bold',
            ]),
            WidgetTree::hbox([
                WidgetTree::lineEdit((string) $state['name'], ['id' => 'name_input', 'placeholder' => '输入名字']),
                WidgetTree::button('打招呼', ['id' => 'greet_btn']),
            ]),
            WidgetTree::label('点击次数：' . $state['clicks'] . ' · 托盘点击 ' . $state['tray'] . ' 次', ['id' => 'clicks']),
            WidgetTree::spacer(1),
        ]);
    });

    // 事件处理器只改状态。闭包参数必须显式标注类型。
    $app->on('greet_btn', 'click', function () use ($app, &$state) {
        $state['name'] = $app->text('name_input');
        $state['greeting'] = 'Hello, ' . ($state['name'] === '' ? 'World' : $state['name']) . '!';
        $state['clicks'] = (int) $state['clicks'] + 1;
        $app->setStatus(['已打招呼 · 第 ' . $state['clicks'] . ' 次']);
    });

    $app->on('name_input', 'submit', function (array $event) use (&$state) {
        $state['name'] = (string) ($event['value'] ?? '');
        $state['greeting'] = 'Hello, ' . ($state['name'] === '' ? 'World' : $state['name']) . '!';
    });

    // 无头验收：--shot <path> 渲染几帧后存 PNG 退出，便于自动化检查
    $shot = shot_path($argv);
    if ($shot !== '') {
        $app->runFrames(3);
        $ok = $app->snapshot($shot);
        echo $ok ? "snapshot: $shot\n" : "snapshot failed\n";
        $app->destroy();
        return;
    }

    // 无头自检：--selftest 逐个触发所有事件，验证每个 handler 都能调用。
    // AOT 编译后的闭包对实参个数做精确校验，参数个数不匹配只有真正
    // 触发事件时才暴露 —— 所以这个自检要实际分发事件。
    if (has_flag($argv, '--selftest')) {
        $app->headless(true);
        $app->run(1);
        $app->dispatch(['type' => 'click', 'id' => 'greet_btn']);
        $app->dispatch(['type' => 'submit', 'id' => 'name_input', 'value' => 'Ada']);
        $app->dispatch(['type' => 'tray', 'value' => 'left']);
        $app->dispatch(['type' => 'tray', 'value' => 'double']);
        $app->dispatch(['type' => 'menu', 'id' => 'tray.hello']);

        if ($app->lastError() !== '') {
            echo "selftest failed: ", $app->lastError(), "\n";
        } else {
            echo "selftest passed\n";
        }
        $app->destroy();
        return;
    }

    $app->run();
}

/** 命令行里是否存在某个布尔开关。 */
function has_flag(array $argv, string $flag): bool
{
    $count = count($argv);
    for ($i = 1; $i < $count; $i++) {
        if ($argv[$i] === $flag) {
            return true;
        }
    }
    return false;
}

/** 从命令行参数里解析 `--shot <path>`；没有该参数返回空串。 */
function shot_path(array $argv): string
{
    $count = count($argv);
    for ($i = 1; $i < $count; $i++) {
        if ($argv[$i] === '--shot' && $i + 1 < $count) {
            return (string) $argv[$i + 1];
        }
    }
    return '';
}
PHP;
    file_put_contents($targetDir . '/src/main.php', $mainPhp);

    // 默认图标：托盘项没有图标在 macOS/Linux 上根本不显示，
    // 所以脚手架直接给一个可用的，而不是留空目录让人踩坑。
    $defaultIcon = base64_decode('');
    file_put_contents($targetDir . '/assets/icon.png', $defaultIcon);

    // build.bat —— 编译 + 部署运行时 DLL
    $vcvars = findVcvars() ?? 'D:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat';
    $buildBat = <<<BAT
@echo off
setlocal
call "{$vcvars}" >nul 2>&1
cd /d %~dp0

php "{$pkgDir}/bin/qtphp" build .

endlocal & exit /b %errorlevel%
BAT;
    file_put_contents($targetDir . '/build.bat', $buildBat);

    // run.bat
    $runBat = <<<BAT
@echo off
setlocal
cd /d %~dp0

if not exist "build\\{$name}.exe" (
    echo [ERROR] 未找到 build\\{$name}.exe，请先运行 build.bat
    endlocal & exit /b 1
)

build\\{$name}.exe %*

endlocal & exit /b %errorlevel%
BAT;
    file_put_contents($targetDir . '/run.bat', $runBat);

    // package.bat
    $packageBat = <<<BAT
@echo off
setlocal
cd /d %~dp0

php "{$pkgDir}/bin/qtphp" package .

endlocal & exit /b %errorlevel%
BAT;
    file_put_contents($targetDir . '/package.bat', $packageBat);

    // README
    $readme = <<<MD
# {$name}

基于 TypePHP (AOT) + Qt 6 的原生桌面应用。

编译入口按平台挑选：`project.yml` 是 Windows 段，`project.macos.yml` 通过 `include` 继承它
再整体替换 Qt 相关段（brew 的 framework 布局 + 私有 embed 运行时）。`qtphp build` 会自动选对。

## 构建

Windows：

```bat
build.bat
```

macOS（或任意平台，走 CLI）：

```bash
qtphp build .
```

Windows 编译后会自动把 Qt / PHP 运行时 DLL 部署到 `build/`；macOS 的依赖来自 brew，
PHP 侧是静态链入，无需部署。

## 运行

```bat
run.bat
```

```bash
qtphp run .                # 图形界面
qtphp run . --selftest     # 无头自检：逐个触发所有事件
qtphp run . --shot out.png # 渲染几帧后存 PNG 退出
```

## 打包

```bat
package.bat
```

```bash
qtphp package .
```

Windows 组装自包含的 `dist/` 目录；macOS 产出 `dist/{$display}.app`
（macdeployqt 搬 Qt framework 与链接库 + ad-hoc 签名 + 自检）。两者都可直接分发。

## 写代码

编辑 `src/main.php`：

- `\$state` 保存应用状态
- `\$app->view(fn)` 每帧按状态描述界面
- `\$app->on(id, type, fn)` 处理事件，**只改状态**

控件状态（输入光标、表格选中、滚动位置）在重渲染后自动保留。
MD;
    file_put_contents($targetDir . '/README.md', $readme);

    success("项目已创建: $targetDir");
    info(PHP_OS_FAMILY === 'Windows'
        ? "下一步: cd $name && build.bat"
        : "下一步: cd $name && qtphp build . && qtphp run . --selftest");

    return 0;
}

/**
 * 定位「PHP/PHPX 运行时库目录」—— 跟「tpc 可执行文件在哪」不是同一回事。
 *
 * composer 只发布纯 PHP 驱动（vendor/bin/tpc.php），它旁边一个运行时库都没有，
 * 拿它的 dirname 去找 phpx.dll 必然空手而归。库的真正来源只有两个：解发型发行包
 * （native tpc.exe 同目录），以及 tpc 用 php-builder 自建的私有运行时
 * ~/.typephp/php-builder/php-<版本>-<指纹>/install/lib。
 */
function findRuntimeLibDir(): ?string
{
    $markers = ['phpx.dll', 'php8ts.dll', 'libphp.a', 'libphp.dylib'];

    $candidates = [];
    $tpc = findTpc();
    // 只有 native 发行包才把运行时放在可执行文件旁边
    if ($tpc && strtolower(pathinfo($tpc, PATHINFO_EXTENSION)) !== 'php') {
        $candidates[] = dirname($tpc);
    }
    $env = getenv('TPC_RUNTIME_DIR');
    if ($env && is_dir($env)) {
        $candidates[] = $env;
    }

    // 私有运行时可能有多份（换过 PHP 版本就换一个指纹目录），取最近构建的
    $home = getenv('HOME') ?: getenv('USERPROFILE');
    if ($home) {
        $built = glob(rtrim($home, '/\\') . '/.typephp/php-builder/php-*/install/lib') ?: [];
        usort($built, fn(string $a, string $b): int => (filemtime($b) ?: 0) <=> (filemtime($a) ?: 0));
        $candidates = array_merge($candidates, $built);
    }

    foreach ($candidates as $dir) {
        foreach ($markers as $marker) {
            if (is_file($dir . '/' . $marker)) {
                return $dir;
            }
        }
    }
    return null;
}

function cmdBuild(string $path): int
{
    $projectYml = resolveProjectYaml($path);
    if (!file_exists($projectYml)) {
        error("未找到 project.yml: " . rtrim($path, '/\\') . '/project.yml');
        return 1;
    }

    info('编译项目: ' . $path . '（入口 ' . basename($projectYml) . '）');

    $tpc = findTpc();
    if (!$tpc) {
        error('未找到 tpc');
        return 1;
    }

    // tpc 需要 MSVC 环境（cl.exe / link.exe 在 PATH 上）。
    // 先写一个临时批处理，在里面 call vcvars64.bat 再调 tpc，
    // 避免依赖用户事先开好 "Developer Command Prompt"。
    $vcvars = findVcvars();
    $projectAbs = realpath($projectYml) ?: $projectYml;
    $tpcCmd = tpcCommand($tpc) . ' ' . escapeshellarg($projectAbs) . ' -O2';

    // Homebrew 的 include/lib 得靠环境变量递给 clang：phpx 的 sapi-static/CMakeLists.txt
    // 没有根 CMakeLists 那段 brew 前缀探测，而 tpc 调 cmake 的参数是写死的、注入不了 flag。
    if (PHP_OS_FAMILY !== 'Windows') {
        $brewPrefix = trim((string) shell_exec('brew --prefix 2>/dev/null'));
        if ($brewPrefix !== '' && is_dir($brewPrefix)) {
            foreach (['CPATH' => '/include', 'LIBRARY_PATH' => '/lib'] as $var => $suffix) {
                $current = getenv($var);
                putenv($var . '=' . $brewPrefix . $suffix . ($current ? ':' . $current : ''));
            }
        }
    }

    if ($vcvars && !msvcEnvironmentReady()) {
        $bat = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'qtphp-build-' . getmypid() . '.bat';
        $lines = [
            '@echo off',
            'call "' . $vcvars . '" >nul 2>&1',
            'cd /d "' . (realpath($path) ?: $path) . '"',
            $tpcCmd,
        ];
        file_put_contents($bat, implode("\r\n", $lines) . "\r\n");
        passthru('cmd /c "' . $bat . '" 2>&1', $exitCode);
        @unlink($bat);
    } else {
        passthru($tpcCmd . ' 2>&1', $exitCode);
    }

    if ($exitCode !== 0) {
        error("编译失败 (exit $exitCode)");
        return $exitCode;
    }

    if (PHP_OS_FAMILY === 'Windows') {
        // 编译成功后自动部署运行时 DLL，否则双击 exe 会报"找不到 DLL"
        deployRuntimeDlls($path);
    } else {
        // macOS/Linux 的 PHP 运行时是静态链接/私有运行时，没有 DLL 要搬，
        // 但 assets/ 同样要拷 —— 否则开发期相对路径失效、打包后才正常。
        deployAssets($path);
    }

    return 0;
}

/**
 * 当前进程是否已有可用的 MSVC 环境。
 *
 * 只查 cl.exe 不够 —— cl.exe 常在系统 PATH 上，但 INCLUDE/LIB 没设置，
 * 结果编译时报 "cstring: No such file or directory"。所以必须查 INCLUDE。
 */
function msvcEnvironmentReady(): bool
{
    $include = getenv('INCLUDE');
    return $include !== false && $include !== '';
}

/**
 * 把运行时依赖 DLL 复制到可执行文件旁。
 *
 * 覆盖三类：PHP/PHPX 运行时、Qt 运行库、MSVC 运行时。
 * Qt 的平台插件（platforms/qwindows.dll）不在这一步，由 package 阶段的
 * windeployqt 负责；开发期直接跑 exe 需要它，所以这里也一并部署。
 */
function deployRuntimeDlls(string $projectPath): void
{
    $buildDir = rtrim($projectPath, '/\\') . '/build';
    if (!is_dir($buildDir)) {
        return;
    }

    $runtimeDir = findRuntimeLibDir();
    $qtDir = findQt();

    $copied = 0;

    // PHP/PHPX 运行时 DLL 闭包（实测依赖）
    $runtimeDlls = [
        'phpx.dll',
        'php8ts.dll',
        'libmpdec++-4.0.1.dll',
        'libmpdec-4.0.1.dll',
        'gmp-10.dll',
        'mpfr-6.dll',
    ];
    if ($runtimeDir === null) {
        warning('未找到 PHP 运行时库目录，跳过 phpx/php8ts 等 DLL 的部署');
        info('请安装 tpc 原生发行包，或设置 TPC_RUNTIME_DIR 指向含 phpx.dll 的目录');
    } else {
        foreach ($runtimeDlls as $dll) {
            $src = $runtimeDir . '/' . $dll;
            if (file_exists($src)) {
                copy($src, $buildDir . '/' . $dll);
                $copied++;
            }
        }
    }

    // Qt 运行库（源码内联方案下 exe 直接依赖这些）
    if ($qtDir) {
        foreach (['Qt6Core.dll', 'Qt6Gui.dll', 'Qt6Widgets.dll'] as $dll) {
            $src = $qtDir . '/bin/' . $dll;
            if (file_exists($src)) {
                copy($src, $buildDir . '/' . $dll);
                $copied++;
            }
        }

        // 平台插件：缺了它 Qt 会报
        // "could not find or load the Qt platform plugin windows"
        //
        // **qoffscreen 必须一起带上**：`--selftest` / `--shot` / `--difftest`
        // 这些无头验收开关在 CI 里要配 QT_QPA_PLATFORM=offscreen 跑，
        // 而 Qt 找不到 offscreen 插件时会直接 abort（0xC0000409），
        // 表现为「一开无头验收就崩」—— 与 macOS bundle 缺
        // libqoffscreen.dylib 是同一个坑（F16→F17），只是 Windows 侧没实测过。
        $pluginDir = $buildDir . '/platforms';
        foreach (['qwindows.dll', 'qoffscreen.dll', 'qminimal.dll'] as $plugin) {
            $src = $qtDir . '/plugins/platforms/' . $plugin;
            if (!file_exists($src)) {
                continue;
            }
            if (!is_dir($pluginDir)) {
                mkdir($pluginDir, 0755, true);
            }
            copy($src, $pluginDir . '/' . $plugin);
            $copied++;
        }

        // 样式插件（Fusion 之外的原生样式）
        $stylesDir = $buildDir . '/styles';
        $stylePlugin = $qtDir . '/plugins/styles/qmodernwindowsstyle.dll';
        if (file_exists($stylePlugin)) {
            if (!is_dir($stylesDir)) {
                mkdir($stylesDir, 0755, true);
            }
            copy($stylePlugin, $stylesDir . '/qmodernwindowsstyle.dll');
            $copied++;
        }
    }

    // MSVC 运行时
    $vcRedist = findVcRedistDir();
    if ($vcRedist) {
        foreach (['msvcp140.dll', 'vcruntime140.dll', 'vcruntime140_1.dll'] as $dll) {
            $src = $vcRedist . '/' . $dll;
            if (file_exists($src) && !file_exists($buildDir . '/' . $dll)) {
                copy($src, $buildDir . '/' . $dll);
                $copied++;
            }
        }
    }

    if ($copied > 0) {
        success("已部署 $copied 个运行时文件到 build/");
    } else {
        warning('未能找到运行时 DLL，exe 可能无法直接运行');
    }

    deployAssets($projectPath);
}

/**
 * 把项目的 assets/ 拷进 build/。
 *
 * `package` 阶段本来就会拷，但开发期直接跑 build/<name>.exe 时不会 ——
 * 于是 'assets/icon.png' 这类相对路径在开发期失效、打包后又能用，
 * 属于「打包才暴露」的坑。这里让两边行为一致。
 */
function deployAssets(string $projectPath): void
{
    $src = rtrim($projectPath, '/\\') . '/assets';
    $dst = rtrim($projectPath, '/\\') . '/build/assets';
    if (!is_dir($src)) {
        return;
    }
    copyDir($src, $dst);
}

/** 定位 VC 运行时 DLL 目录（msvcp140.dll 等）。 */
function findVcRedistDir(): ?string
{
    $roots = [
        'C:/Windows/System32',
        'C:/Program Files/Microsoft Visual Studio/2022/BuildTools/VC/Redist/MSVC',
        'C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Redist/MSVC',
    ];
    foreach ($roots as $root) {
        if (!is_dir($root)) continue;
        if (file_exists($root . '/msvcp140.dll')) {
            return $root;
        }
        // Redist 目录下有多层版本号，找最新一个
        $dirs = glob($root . '/*/x64/Microsoft.VC143.CRT', GLOB_ONLYDIR) ?: [];
        rsort($dirs);
        foreach ($dirs as $dir) {
            if (file_exists($dir . '/msvcp140.dll')) {
                return $dir;
            }
        }
    }
    return null;
}

/**
 * 规范化项目目录。
 *
 * `qtphp run .` / `qtphp package .` 是 README 和生成的 package.bat 里的写法，而 PHP 的
 * `basename('.')` 返回 `.`，产物会被算成 `./build/.` —— 那是个目录，`file_exists()` 还为真，
 * 于是错误被推迟到更看不懂的地方。路径不存在时原样返回，让下游报「未找到」。
 */
function projectDir(string $path): string
{
    $dir = rtrim($path, '/\\');
    $real = realpath($dir);
    return $real !== false ? $real : $dir;
}

function cmdRun(string $path, array $args = []): int
{
    $dir = projectDir($path);
    $name = basename($dir);
    $exe = $dir . '/build/' . $name . (PHP_OS_FAMILY === 'Windows' ? '.exe' : '');
    if (!file_exists($exe)) {
        error("未找到可执行文件: $exe");
        info("请先运行: qtphp build $path");
        return 1;
    }

    // 缺依赖时给出可操作的提示，而不是让系统弹一个看不懂的错误框
    $missing = PHP_OS_FAMILY === 'Windows'
        ? checkRuntimeDlls(dirname($exe))
        : checkSharedLibraryDeps($exe);
    if ($missing) {
        warning('以下运行时依赖缺失，可能无法启动：' . implode(', ', $missing));
        if (PHP_OS_FAMILY === 'Windows') {
            info("运行 'qtphp build $path' 可自动部署；或执行 'qtphp package $path' 生成自包含目录。");
        } elseif (PHP_OS_FAMILY === 'Linux') {
            info('Linux 的 Qt 依赖来自系统包：apt install qt6-base-dev（headless 验收还需 libqt6widgets6 的 platforms 插件）。');
        } else {
            info('macOS 的依赖来自 brew（qtbase/libiconv/gmp/mpfr）与 ~/.typephp 私有运行时，重新 build 会重建链接。');
        }
    }

    // 其余参数原样透传给应用（--selftest / --shot 这些无头验收开关靠这一步才可用）
    $cmd = escapeshellarg($exe);
    foreach ($args as $arg) {
        $cmd .= ' ' . escapeshellarg($arg);
    }
    info('运行: ' . $exe . ($args ? ' ' . implode(' ', $args) : ''));
    passthru($cmd . ' 2>&1', $exitCode);
    return $exitCode;
}

/**
 * 非 Windows：问动态链接器要依赖清单，逐条确认能不能加载。
 *
 * 比"照着名单复制 DLL"可靠 —— brew 前缀、keg-only 路径、私有运行时的绝对路径
 * 都已经写在二进制的加载命令里了。@rpath 形式交给 dyld 解析，静态检查无意义。
 *
 * 系统库必须跳过：macOS 11 起 /usr/lib 下的 dylib 只存在于 dyld shared cache，
 * 磁盘上没有文件但加载正常，按 file_exists 判会全部误报。
 */
function checkSharedLibraryDeps(string $exe): array
{
    if (PHP_OS_FAMILY === 'Linux') {
        return checkLinuxLibraryDeps($exe);
    }

    $output = shell_exec('otool -L ' . escapeshellarg($exe) . ' 2>/dev/null');
    if (!$output) {
        return [];
    }

    $missing = [];
    foreach (explode("\n", $output) as $line) {
        if (!preg_match('/^\s*(\/\S+\.dylib)\s+\(compatibility/', $line, $m)) {
            continue;
        }
        $path = $m[1];
        if (str_starts_with($path, '/usr/lib/') || str_starts_with($path, '/System/Library/')) {
            continue;
        }
        if (!file_exists($path)) {
            $missing[] = $path;
        }
    }
    return $missing;
}

/**
 * Linux：`ldd` 的清单里只有两种真问题 —— `not found`（库里没有这个 .so），
 * 以及指向构建树/私有目录又确实不存在的绝对路径。
 * 系统前缀（/usr/lib、/lib、/usr/local/lib）直接放行：那是发行版该负责的部分。
 */
function checkLinuxLibraryDeps(string $exe): array
{
    $output = shell_exec('ldd ' . escapeshellarg($exe) . ' 2>/dev/null');
    if ($output === null || $output === '') {
        return [];
    }

    $missing = [];
    foreach (explode("\n", $output) as $line) {
        if (preg_match('/^\s*(\S+)\s+=>\s+not found/', $line, $m)) {
            $missing[] = $m[1] . ' (not found)';
            continue;
        }
        if (preg_match('/^\s*\S+\s+=>\s+(\/\S+)/', $line, $m)) {
            $path = $m[1];
            foreach (['/usr/lib', '/usr/local/lib', '/lib'] as $systemPrefix) {
                if (str_starts_with($path, $systemPrefix . '/')) {
                    continue 2;
                }
            }
            if (!file_exists($path)) {
                $missing[] = $path;
            }
        }
    }
    return array_values(array_unique($missing));
}

/** 检查 exe 同目录下缺失的运行时 DLL。 */
function checkRuntimeDlls(string $dir): array
{
    $required = [
        'phpx.dll',
        'php8ts.dll',
        'libmpdec++-4.0.1.dll',
        'Qt6Core.dll',
        'Qt6Gui.dll',
        'Qt6Widgets.dll',
        'platforms/qwindows.dll',
    ];
    $missing = [];
    foreach ($required as $dll) {
        if (!file_exists($dir . '/' . $dll)) {
            $missing[] = $dll;
        }
    }
    return $missing;
}

function cmdPackage(string $path): int
{
    $path = projectDir($path);
    $name = basename($path);
    $exe = $path . '/build/' . $name . (PHP_OS_FAMILY === 'Windows' ? '.exe' : '');
    if (!file_exists($exe)) {
        error("未找到可执行文件: $exe");
        info("请先运行: qtphp build $path");
        return 1;
    }

    $distDir = $path . '/dist';
    if (!is_dir($distDir)) {
        mkdir($distDir, 0755, true);
    }

    if (PHP_OS_FAMILY === 'Darwin') {
        return packageAppBundle($path, $name, $exe, $distDir);
    }
    if (PHP_OS_FAMILY === 'Linux') {
        return packageLinuxDir($path, $name, $exe, $distDir);
    }
    if (PHP_OS_FAMILY !== 'Windows') {
        // 显式报错，别让 BSD 之类跑到 Windows 分支上去找 windeployqt
        error('未实现 ' . PHP_OS_FAMILY . ' 平台的打包：目前只有 Windows 的 dist/ 目录、macOS 的 .app 与 Linux 的 dist/<name>/ 三条路线');
        return 1;
    }

    info("打包到: $distDir");

    // 先补齐运行时 DLL（幂等）
    deployRuntimeDlls($path);

    // 复制 exe 与 build/ 下全部 DLL
    $buildDir = $path . '/build';
    foreach (glob($buildDir . '/*.exe') as $file) {
        copy($file, $distDir . '/' . basename($file));
    }
    foreach (glob($buildDir . '/*.dll') as $file) {
        copy($file, $distDir . '/' . basename($file));
    }

    // assets 目录（如果项目有）
    if (is_dir($path . '/assets')) {
        copyDir($path . '/assets', $distDir . '/assets');
    }

    // Qt 依赖 + 平台插件：缺了这一步会在启动时报
    // "could not find or load the Qt platform plugin windows"
    $qtDir = findQt();
    if (!$qtDir) {
        error('未找到 Qt，无法部署 Qt 依赖');
        return 1;
    }
    $windeployqt = $qtDir . '/bin/windeployqt.exe';
    if (!file_exists($windeployqt)) {
        error("未找到 windeployqt: $windeployqt");
        return 1;
    }
    info('运行 windeployqt（部署 Qt DLL 与平台插件）...');
    passthru('"' . $windeployqt . '" --no-translations --no-compiler-runtime "' . $distDir . '/' . $name . '.exe" 2>&1', $qtExit);
    if ($qtExit !== 0) {
        warning("windeployqt 返回 $qtExit，继续检查产物");
    }

    vendorWindowsOffscreenPlugin($qtDir, $distDir);

    // 自检：验证关键文件齐全
    return verifyPackage($distDir, $name);
}

/**
 * macOS 打包：产出 dist/<Name>.app，把 Qt framework、cocoa 插件和 brew 链接库都塞进 bundle。
 *
 * 流程对齐 typephp-compiler 的 examples/qt-taskboard/package-macos-app.sh：
 * 搭 bundle 骨架 → macdeployqt → 补 offscreen 插件 → 补搬它不管的非 Qt 依赖 → ad-hoc 签名 → 校验。
 * 我们的 PHP/PHPX 是静态链进二进制的（--enable-embed=static），所以没有 libphp.dylib 要搬。
 */
function packageAppBundle(string $path, string $name, string $exe, string $distDir): int
{
    $qtDir = findQt();
    if (!$qtDir) {
        error('未找到 Qt，无法部署 Qt 依赖');
        return 1;
    }
    $deploy = $qtDir . '/bin/macdeployqt';
    if (!is_executable($deploy)) {
        error("未找到 macdeployqt: $deploy");
        return 1;
    }
    $plist = $path . '/Info.macos.plist';
    if (!file_exists($plist)) {
        error("未找到 bundle 描述文件: $plist");
        return 1;
    }

    $bundle = $distDir . '/' . ucfirst($name) . '.app';
    $contents = $bundle . '/Contents';
    $frameworks = $contents . '/Frameworks';
    $appBinary = $contents . '/MacOS/' . $name;

    // 旧 bundle 的 install name 已经被改写过，留着会污染这一轮判断，整棵重建
    if (is_dir($bundle)) {
        deleteTree($bundle);
    }
    mkdir($contents . '/MacOS', 0755, true);
    mkdir($frameworks, 0755, true);

    info("打包到: $bundle");
    copy($plist, $contents . '/Info.plist');
    copy($exe, $appBinary);
    chmod($appBinary, 0755);

    if (is_dir($path . '/assets')) {
        copyDir($path . '/assets', $contents . '/Resources/assets');
    }

    info('运行 macdeployqt（部署 Qt framework、cocoa 插件与链接库）...');
    passthru(escapeshellarg($deploy) . ' ' . escapeshellarg($bundle) . ' -always-overwrite -no-codesign 2>&1', $qtExit);
    if ($qtExit !== 0) {
        warning("macdeployqt 返回 $qtExit，继续检查产物");
    }

    $headless = vendorHeadlessPlugin($qtDir, $contents);
    if ($headless !== '') {
        info('已补无头验收插件: ' . basename($headless));
    }

    $vendored = vendorBundleDeps($appBinary, $frameworks);
    if ($headless !== '') {
        $vendored = array_merge($vendored, vendorBundleDeps($headless, $frameworks));
    }
    if ($vendored) {
        info('已搬进 bundle：' . implode(', ', $vendored));
    }

    // 本地自测 ad-hoc 签名够用；分发给别人的机器需要正经签名 + 公证
    info('ad-hoc 签名...');
    passthru('codesign --force --deep --sign - ' . escapeshellarg($bundle) . ' 2>&1', $signExit);
    if ($signExit !== 0) {
        warning("codesign 返回 $signExit");
    }

    return verifyAppBundle($bundle, $appBinary);
}

/**
 * Linux 打包：产出 dist/<name>/ —— 二进制 + Qt 插件 + ldd 依赖闭包。
 *
 * Linux 的加载器不搜可执行文件同目录（和 Windows 相反），所以依赖集中放 lib/，
 * 再用 patchelf 把 rpath 改成 $ORIGIN/lib。这里必须是 DT_RPATH 而不是 DT_RUNPATH：
 * RUNPATH 只对本对象自己的 NEEDED 生效，那样 libQt6Gui 的 libglib/libEGL 这些
 * 二级依赖还是会回落到系统的 ld.so.cache，产物看着能跑其实没自包含。
 */
function packageLinuxDir(string $path, string $name, string $exe, string $distDir): int
{
    $patchelf = trim((string) shell_exec('command -v patchelf 2>/dev/null'));
    if ($patchelf === '') {
        error('未找到 patchelf，无法改写 rpath 做自包含打包');
        info('请先运行: apt install patchelf');
        return 1;
    }
    $qtDir = findQt();
    if (!$qtDir) {
        error('未找到 Qt，无法部署 Qt 插件与依赖');
        return 1;
    }
    $pluginDirs = linuxQtPluginDirs($qtDir);
    if (!$pluginDirs) {
        error("未找到 Qt 平台插件目录（$qtDir/lib/*/qt6/plugins/platforms）");
        return 1;
    }

    $root = $distDir . '/' . $name;
    if (is_dir($root)) {
        deleteTree($root);
    }
    $libDir = $root . '/lib';
    mkdir($libDir, 0755, true);

    info("打包到: $root");
    copy($exe, $root . '/' . $name);
    chmod($root . '/' . $name, 0755);
    if (is_dir($path . '/assets')) {
        copyDir($path . '/assets', $root . '/assets');
    }

    // 插件按产物内相对目录复刻一份，闭包用系统里的原件算（ldd 对插件同样给传递闭包）
    $closureRoots = [$exe];
    $plugins = [];
    foreach ($pluginDirs as $rel => $srcDir) {
        $dstDir = $root . '/plugins/' . $rel;
        if (!is_dir($dstDir)) {
            mkdir($dstDir, 0755, true);
        }
        foreach (glob($srcDir . '/*.so') ?: [] as $src) {
            $dst = $dstDir . '/' . basename($src);
            copy($src, $dst);
            $closureRoots[] = $src;
            $plugins[] = $dst;
        }
    }
    // Qt 只从 qt.conf 或环境变量找插件目录，写死成产物内的相对路径才能脱离开发环境
    file_put_contents($root . '/qt.conf', "[Paths]\nPlugins = plugins\n");

    $libs = [];
    foreach ($closureRoots as $object) {
        foreach (elfDeps($object) as $soname => $abs) {
            if (isset($libs[$soname]) || isSystemSoname($soname) || !file_exists($abs)) {
                continue;
            }
            // 落地名用 soname（libQt6Core.so.6），不是 readlink 后的真名，否则按 soname 找不到
            copy($abs, $libDir . '/' . $soname);
            $libs[$soname] = true;
        }
    }
    info('已搬入依赖: ' . count($libs) . " 个 .so，平台插件 " . count($plugins) . ' 个');

    if (!setLinuxRpath($patchelf, $root . '/' . $name, '$ORIGIN/lib')) {
        return 1;
    }
    foreach ($plugins as $plugin) {
        setLinuxRpath($patchelf, $plugin, '$ORIGIN/../../lib');
    }

    return verifyLinuxPackage($root, $name, $patchelf);
}

/** Debian/Ubuntu 是 lib/<三元组>/qt6/plugins，上游 tarball 常是扁平 plugins。 */
function linuxQtPluginDirs(string $qtDir): array
{
    $bases = [];
    $triple = linuxMultiarchTriple();
    if ($triple !== null) {
        $bases[] = $qtDir . '/lib/' . $triple . '/qt6/plugins';
    }
    $bases[] = $qtDir . '/lib/qt6/plugins';
    $bases[] = $qtDir . '/plugins';
    $base = '';
    foreach ($bases as $candidate) {
        if (is_dir($candidate . '/platforms')) {
            $base = $candidate;
            break;
        }
    }
    if ($base === '') {
        return [];
    }

    // platforms 全量拷：offscreen 是无头验收的前提，xcb 是真实桌面，minimal 兜底
    // xcbglintegrations 缺了 Qt 会退回 GLX 并告警，有就一起带上
    $found = [];
    foreach (['platforms', 'xcbglintegrations'] as $rel) {
        if (is_dir($base . '/' . $rel)) {
            $found[$rel] = $base . '/' . $rel;
        }
    }
    return $found;
}

/** 动态加载的 ELF 依赖：ldd 的 `soname => /abs/path`；vdso 与解释器行没有 `=>`，天然过滤。 */
function elfDeps(string $object): array
{
    $output = shell_exec('ldd ' . escapeshellarg($object) . ' 2>/dev/null');
    $deps = [];
    foreach (explode("\n", (string) $output) as $line) {
        if (preg_match('/^\s*(\S+)\s+=>\s+(\/\S+)/', $line, $m)) {
            $deps[$m[1]] = $m[2];
        }
    }
    return $deps;
}

/**
 * 这些留在目标系统上：glibc 家族的 ABI 由内核-用户态边界保证，搬了反而容易和
 * 目标机的 ld.so 版本不匹配（libstdc++ 不在此列，它按 GLIBCXX 符号版本卡，必须搬）。
 */
function isSystemSoname(string $soname): bool
{
    foreach (['libc.', 'libm.', 'libdl.', 'librt.', 'libpthread.', 'libresolv.',
              'libnsl.', 'libutil.', 'libgcc_s.', 'ld-linux-'] as $prefix) {
        if (str_starts_with($soname, $prefix)) {
            return true;
        }
    }
    return false;
}

/** 改写 rpath；--force-rpath 保证写的是可传递的 DT_RPATH。 */
function setLinuxRpath(string $patchelf, string $object, string $rpath): bool
{
    exec($patchelf . ' --force-rpath --set-rpath ' . escapeshellarg($rpath)
        . ' ' . escapeshellarg($object) . ' 2>&1', $out, $rc);
    if ($rc !== 0) {
        error('patchelf 改写 ' . basename($object) . ' 失败：' . implode(' ', $out));
        return false;
    }
    return true;
}

/**
 * 自检产物：依赖必须全在 dist/<name>/lib 内。
 *
 * ldd 会展开 $ORIGIN 并解析整张传递图，所以「每一行都落在产物里」就是自包含的实测证据；
 * 有漏的会直接显示成系统绝对路径。
 */
function verifyLinuxPackage(string $root, string $name, string $patchelf): int
{
    echo PHP_EOL;
    info('自检打包产物...');
    $ok = true;

    $exe = $root . '/' . $name;
    $libReal = realpath($root . '/lib') ?: ($root . '/lib');
    $leaked = [];
    // 可执行文件的 ldd 已经含传递闭包，但插件不在那条链上：libqxcb.so 的十几个 xcb 库
    // 只有对插件自己跑 ldd 才看得见，而它们恰恰是最容易漏搬的一批。
    $objects = [$exe];
    foreach (glob($root . '/plugins/*/*.so') ?: [] as $plugin) {
        $objects[] = $plugin;
    }
    foreach ($objects as $object) {
        foreach (elfDeps($object) as $soname => $abs) {
            if (isSystemSoname($soname)) {
                continue;
            }
            // $ORIGIN 是按传入路径的 dirname 文本展开的，可能带出 /./ 这种写法，先规范化再比
            $realAbs = realpath($abs) ?: $abs;
            if (!str_starts_with($realAbs, $libReal . '/')) {
                $leaked[] = basename($object) . ' 的 ' . $soname . " => $abs";
            }
        }
    }
    if ($leaked) {
        error('仍指向产物之外：');
        foreach (array_unique($leaked) as $line) {
            echo "  - $line" . PHP_EOL;
        }
        $ok = false;
    }

    if (!file_exists($root . '/plugins/platforms/libqoffscreen.so')) {
        error('产物内没有 libqoffscreen.so，无法在无 GUI 会话的机器上验收');
        $ok = false;
    }

    // DT_RUNPATH 一旦同时存在就会顶掉 DT_RPATH（patchelf 老版本踩过），直接读 dynamic 段确认
    exec('readelf -d ' . escapeshellarg($exe) . ' 2>/dev/null', $lines, $rdRc);
    $dynamic = implode("\n", $lines);
    if ($rdRc !== 0 || !str_contains($dynamic, '(RPATH)') || str_contains($dynamic, '(RUNPATH)')) {
        error("rpath 改写结果不是 DT_RPATH，二级依赖仍会回落系统库（patchelf: $patchelf）");
        $ok = false;
    }

    if (!$ok) {
        return 1;
    }

    success(sprintf('打包完成: %s (%.1f MB)', $root, dirSize($root) / 1048576));
    info('启动: ' . escapeshellarg($exe));
    info('无头验收: env -i QT_QPA_PLATFORM=offscreen ' . escapeshellarg($exe) . ' --selftest');
    return 0;
}

/** 读 Mach-O 的依赖清单（otool -L 的路径列）；@rpath 等形式原样返回。 */
function machODeps(string $binary): array
{
    $output = shell_exec('otool -L ' . escapeshellarg($binary) . ' 2>/dev/null');
    if (!$output) {
        return [];
    }

    $deps = [];
    foreach (explode("\n", $output) as $line) {
        if (preg_match('/^\s*(\S+)\s+\(compatibility/', $line, $m)) {
            $deps[] = $m[1];
        }
    }
    return $deps;
}

/**
 * 系统库要跳过：macOS 11 起 /usr/lib 下的 dylib 只存在于 dyld shared cache，
 * 磁盘上没有文件却加载正常，按 file_exists 判会全部误报。
 */
function isSystemDepPath(string $path): bool
{
    return str_starts_with($path, '/usr/lib/') || str_starts_with($path, '/System/Library/');
}

/**
 * 把 offscreen 平台插件拷进 bundle，并返回其路径（找不到就返回空串）。
 *
 * macdeployqt 只按目标平台拷 cocoa，产物因此**无法无头验收**：设了 QT_QPA_PLATFORM=offscreen
 * 又找不到插件时 Qt 直接 abort（rc=134），CI 里没有 GUI 会话就测不了打包产物。
 * 拷进来的 Qt 引用要改写成 @executable_path —— 原样的 @rpath 指向 `@loader_path/../../../../lib`，
 * 在 bundle 里会算到 dist/lib 这种不存在的位置。
 */
function vendorHeadlessPlugin(string $qtDir, string $contents): string
{
    $src = '';
    foreach (['/share/qt/plugins/platforms', '/plugins/platforms', '/lib/qt6/plugins/platforms'] as $rel) {
        if (is_file($qtDir . $rel . '/libqoffscreen.dylib')) {
            $src = $qtDir . $rel . '/libqoffscreen.dylib';
            break;
        }
    }
    if ($src === '') {
        warning('未找到 libqoffscreen.dylib，产物只能在有 GUI 会话的机器上验收');
        return '';
    }

    $dir = $contents . '/PlugIns/platforms';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
    $dst = $dir . '/libqoffscreen.dylib';
    copy($src, $dst);
    chmod($dst, 0644);

    foreach (['QtCore', 'QtGui', 'QtWidgets'] as $fw) {
        exec('install_name_tool -change ' . escapeshellarg('@rpath/' . $fw . '.framework/Versions/A/' . $fw)
            . ' ' . escapeshellarg('@executable_path/../Frameworks/' . $fw . '.framework/Versions/A/' . $fw)
            . ' ' . escapeshellarg($dst) . ' 2>&1', $out, $rc);
        if ($rc !== 0) {
            warning("改写插件对 $fw 的引用失败：" . implode(' ', $out));
        }
    }

    return $dst;
}

/**
 * Windows 侧对齐 macOS 的 `vendorHeadlessPlugin()`：保证 `platforms/qoffscreen.dll` 在产物里。
 *
 * windeployqt 的默认插件清单没有权威结论，所以这里不依赖它 —— 已部署就跳过，没部署才补。
 * 补拷是安全的：`qwindows.dll` 今天就是这样从 `platforms/` 加载、并解析到 exe 同目录的 Qt6*.dll 的。
 * 本机没有 Windows 环境，这条路径**未实测**。
 */
function vendorWindowsOffscreenPlugin(string $qtDir, string $distDir): void
{
    $dst = $distDir . '/platforms/qoffscreen.dll';
    if (file_exists($dst)) {
        return;
    }
    $src = $qtDir . '/plugins/platforms/qoffscreen.dll';
    if (!is_file($src)) {
        warning("未找到 $src，产物只能在有桌面会话的机器上验收");
        return;
    }
    if (!is_dir($distDir . '/platforms')) {
        mkdir($distDir . '/platforms', 0755, true);
    }
    copy($src, $dst);
    info('已补无头验收插件: qoffscreen.dll');
}

/**
 * 把仍指向 brew / 私有运行时的绝对路径依赖复制进 Frameworks 并改写引用。
 *
 * macdeployqt 只管 Qt 自己的东西，libiconv/gmp/mpfr/onig 这些得自己搬。
 * 队列里既放主二进制也放每个刚搬进来的 dylib —— 它们自身的依赖同样要改。
 */
function vendorBundleDeps(string $appBinary, string $frameworks): array
{
    $vendored = [];
    $queue = [$appBinary];
    $done = [];

    while ($queue) {
        $target = array_shift($queue);
        if (isset($done[$target])) {
            continue;
        }
        $done[$target] = true;

        foreach (machODeps($target) as $dep) {
            if (!str_starts_with($dep, '/') || isSystemDepPath($dep) || !file_exists($dep)) {
                continue;
            }
            $base = basename($dep);
            $dst = $frameworks . '/' . $base;
            $newName = '@executable_path/../Frameworks/' . $base;

            if (!file_exists($dst)) {
                copy($dep, $dst);
                chmod($dst, 0644);
                exec('install_name_tool -id ' . escapeshellarg($newName) . ' ' . escapeshellarg($dst) . ' 2>&1', $out, $rc);
                if ($rc !== 0) {
                    warning("改写 $base 的 install name 失败：" . implode(' ', $out));
                    continue;
                }
                $queue[] = $dst;
                $vendored[] = $base;
            }

            exec('install_name_tool -change ' . escapeshellarg($dep) . ' ' . escapeshellarg($newName)
                . ' ' . escapeshellarg($target) . ' 2>&1', $out2, $rc2);
            if ($rc2 !== 0) {
                warning("改写 $target 对 $base 的引用失败：" . implode(' ', $out2));
            }
        }
    }

    return array_values(array_unique($vendored));
}

/** 自检 .app：依赖是否全部落进 bundle、plist 是否合法、签名是否可验。 */
function verifyAppBundle(string $bundle, string $appBinary): int
{
    echo PHP_EOL;
    info('自检打包产物...');
    $ok = true;

    $external = [];
    foreach (machODeps($appBinary) as $dep) {
        if (str_starts_with($dep, '/') && !isSystemDepPath($dep)) {
            $external[] = $dep;
        }
    }
    if ($external) {
        error('仍指向 bundle 之外：');
        foreach ($external as $dep) {
            echo "  - $dep" . PHP_EOL;
        }
        $ok = false;
    }

    exec('plutil -lint ' . escapeshellarg($bundle . '/Contents/Info.plist') . ' 2>&1', $lint, $lintRc);
    if ($lintRc !== 0) {
        error('Info.plist 不合法：' . implode(' ', $lint));
        $ok = false;
    }

    exec('codesign --verify --deep --strict ' . escapeshellarg($bundle) . ' 2>&1', $verify, $verifyRc);
    if ($verifyRc !== 0) {
        warning('codesign 校验未通过：' . implode(' ', $verify));
    }

    if (!$ok) {
        return 1;
    }

    success(sprintf('打包完成: %s (%.1f MB)', $bundle, dirSize($bundle) / 1048576));
    info('启动: open ' . escapeshellarg($bundle));
    return 0;
}

/** 递归删目录树（只用于重建自己生成的 bundle）。 */
function deleteTree(string $dir): void
{
    foreach (scandir($dir) ?: [] as $item) {
        if ($item === '.' || $item === '..') {
            continue;
        }
        $path = $dir . '/' . $item;
        if (is_dir($path) && !is_link($path)) {
            deleteTree($path);
        } else {
            @unlink($path);
        }
    }
    @rmdir($dir);
}

/** 自检打包产物：关键 DLL、平台插件、可执行文件是否齐全。 */
function verifyPackage(string $distDir, string $name): int
{
    echo PHP_EOL;
    info('自检打包产物...');

    $required = [
        $name . '.exe',
        'phpx.dll',
        'php8ts.dll',
        'Qt6Core.dll',
        'Qt6Gui.dll',
        'Qt6Widgets.dll',
        'platforms/qwindows.dll',
    ];

    $missing = [];
    foreach ($required as $file) {
        if (!file_exists($distDir . '/' . $file)) {
            $missing[] = $file;
        }
    }

    if ($missing) {
        error('缺少关键文件：');
        foreach ($missing as $file) {
            echo "  - $file" . PHP_EOL;
        }
        return 1;
    }

    // 统计产物大小
    $size = dirSize($distDir);
    success(sprintf('打包完成: %s (%.1f MB)', $distDir, $size / 1048576));
    info('关键文件齐全，可脱离开发环境运行。');
    return 0;
}

function copyDir(string $src, string $dst): void
{
    if (!is_dir($dst)) {
        mkdir($dst, 0755, true);
    }
    foreach (scandir($src) ?: [] as $item) {
        if ($item === '.' || $item === '..') continue;
        $s = $src . '/' . $item;
        $d = $dst . '/' . $item;
        if (is_dir($s)) {
            copyDir($s, $d);
        } else {
            copy($s, $d);
        }
    }
}

function dirSize(string $dir): int
{
    $size = 0;
    $iterator = new \RecursiveIteratorIterator(
        new \RecursiveDirectoryIterator($dir, \FilesystemIterator::SKIP_DOTS)
    );
    foreach ($iterator as $file) {
        if ($file->isFile()) {
            $size += $file->getSize();
        }
    }
    return $size;
}

function cmdTest(): int
{
    $phpunit = $GLOBALS['rootDir'] . '/vendor/bin/phpunit';
    if (!file_exists($phpunit)) {
        error('未找到 PHPUnit，请运行: composer install');
        return 1;
    }

    info('运行测试...');
    // phpunit.xml 里已配置 bootstrap，无需再传
    passthru('"' . $phpunit . '" --colors=always 2>&1', $exitCode);
    return $exitCode;
}

function cmdLint(): int
{
    echo color('=== 桥接契约校验 ===', 'bold') . PHP_EOL . PHP_EOL;

    $stubFile = $GLOBALS['rootDir'] . '/php-src/qt.stub.php';
    if (!file_exists($stubFile)) {
        error("未找到 stub 文件: $stubFile");
        return 1;
    }

    $content = file_get_contents($stubFile);

    // 提取 stub 函数
    preg_match_all('/function\s+(qt_\w+)\s*\(([^)]*)\)/', $content, $matches, PREG_SET_ORDER);
    $stubFunctions = [];
    foreach ($matches as $match) {
        $stubFunctions[] = 'php_' . $match[1];
    }

    info('Stub 函数 (' . count($stubFunctions) . ' 个):');
    foreach ($stubFunctions as $fn) {
        echo "  - $fn" . PHP_EOL;
    }

    // 检查 C++ 实现
    $cppFiles = glob($GLOBALS['rootDir'] . '/cpp-src/*.cc');
    $definedFunctions = [];
    foreach ($cppFiles as $file) {
        $cpp = file_get_contents($file);
        preg_match_all('/^(?:Variant|void|Bool|String|Int|Array)\s+(php_\w+)\s*\(/m', $cpp, $cppMatches);
        foreach ($cppMatches[1] as $fn) {
            $definedFunctions[] = $fn;
        }
    }

    echo PHP_EOL;
    info('C++ 实现 (' . count($definedFunctions) . ' 个):');
    foreach ($definedFunctions as $fn) {
        echo "  - $fn" . PHP_EOL;
    }

    // 比对
    echo PHP_EOL;
    $missing = array_diff($stubFunctions, $definedFunctions);
    $extra = array_diff($definedFunctions, $stubFunctions);

    if (empty($missing) && empty($extra)) {
        success('契约一致！');
        return 0;
    }

    if (!empty($missing)) {
        error('C++ 中缺失的实现:');
        foreach ($missing as $fn) {
            echo "  - $fn" . PHP_EOL;
        }
    }

    if (!empty($extra)) {
        warning('C++ 中多余的实现:');
        foreach ($extra as $fn) {
            echo "  - $fn" . PHP_EOL;
        }
    }

    return 1;
}

// ── 主入口 ──

function main(array $argv): int
{
    $GLOBALS['rootDir'] = dirname(__DIR__);

    if (count($argv) < 2) {
        echo color('TypePHP\\Qt 工具', 'bold') . PHP_EOL . PHP_EOL;
        echo '用法:' . PHP_EOL;
        echo '  qtphp doctor            检查工具链' . PHP_EOL;
        echo '  qtphp new <name>        创建新项目' . PHP_EOL;
        echo '  qtphp build <path>      编译项目' . PHP_EOL;
        echo '  qtphp run <path> [app参数…]  运行项目，其后的参数原样透传给应用' . PHP_EOL;
        echo '  qtphp package <path>    打包项目' . PHP_EOL;
        echo '  qtphp test              运行测试' . PHP_EOL;
        echo '  qtphp lint              校验桥接契约' . PHP_EOL;
        return 0;
    }

    $command = $argv[1];

    switch ($command) {
        case 'doctor':
            return cmdDoctor();
        case 'new':
            if (!isset($argv[2])) {
                error('请指定项目名称');
                return 1;
            }
            return cmdNew($argv[2]);
        case 'build':
            if (!isset($argv[2])) {
                error('请指定项目路径');
                return 1;
            }
            return cmdBuild($argv[2]);
        case 'run':
            if (!isset($argv[2])) {
                error('请指定项目路径');
                return 1;
            }
            // 第 3 个参数起全部透传给应用（--selftest / --shot 等）
            return cmdRun($argv[2], array_slice($argv, 3));
        case 'package':
            if (!isset($argv[2])) {
                error('请指定项目路径');
                return 1;
            }
            return cmdPackage($argv[2]);
        case 'test':
            return cmdTest();
        case 'lint':
            return cmdLint();
        default:
            error("未知命令: $command");
            return 1;
    }
}

exit(main($argv));
